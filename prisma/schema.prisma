generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OfficialTeam {
  id                Int      @id @default(autoincrement())
  teamName          String
  callsign          String
  mainCid           Int
  aircraftType      String
  country           String
  sinceYear         Int?
  multiSlot         Boolean  @default(false)
  description       String?
  website           String?
  sortOrder         Int      @default(0)
  participatingWf26 Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model Affiliate {
  id                Int      @id @default(autoincrement())
  name              String?
  callsign          String
  simType           String
  cid               Int
  sinceYear         Int?
  hasMembers        Boolean  @default(false)
  aircraftType      String?
  description       String?
  website           String?
  sortOrder         Int      @default(0)
  participatingWf26 Boolean  @default(false)
  createdAt         DateTime @default(now())
}

model AffiliateMember {
  id          Int      @id @default(autoincrement())
  affiliateId Int
  cid         Int
  active      Boolean  @default(true)
  addedAt     DateTime @default(now())

  @@unique([affiliateId, cid])
  @@index([affiliateId])
  @@index([cid])
}

model AffiliateSectorClaim {
  id           Int      @id @default(autoincrement())
  affiliateId  Int
  sectorNumber String
  cid          Int
  claimedAt    DateTime @default(now())

  @@unique([affiliateId, sectorNumber])
  @@index([affiliateId])
  @@index([cid])
}

model DepFlow {
  id        Int      @id @default(autoincrement())
  eventId   Int
  sector    String
  rate      Int
  flowtype  String   @default("NONE")
  updatedAt DateTime @updatedAt

  @@unique([eventId, sector])
  @@index([eventId])
}

model TobtBooking {
  id            Int      @id @default(autoincrement())
  slotKey       String
  cid           Int
  callsign      String
  from          String
  to            String
  dateUtc       String
  depTimeUtc    String
  tobtTimeUtc   String?
  assignedRoute String   @default("A")  // 'A' = primary route, 'B' = secondary route
  manual        Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@unique([cid, slotKey])
}

model User {
  cid  Int    @id
  name String
}

model Airport {
  icao    String   @id
  name    String?
  iata    String?
  lat     Float
  lon     Float
  elev    Int?
  runways Runway[]
}

model Runway {
  id          Int     @id @default(autoincrement())
  airportIcao String
  ident1      String?
  ident2      String?
  lat1        Float
  lon1        Float
  lat2        Float
  lon2        Float
  airport     Airport @relation(fields: [airportIcao], references: [icao], onDelete: Cascade)
}

model AirportScenery {
  id          Int      @id @default(autoincrement())
  icao        String
  sim         String
  name        String
  developer   String?
  store       String?
  url         String
  type        String
  submittedBy String
  submittedAt DateTime @default(now())
  approved    Boolean  @default(false)
  approvedBy  String?
  approvedAt  DateTime?

  reports     SceneryReport[]

  @@index([icao])
  @@index([approved])
}

model SceneryReport {
  id          Int      @id @default(autoincrement())
  sceneryId   Int
  reason      String
  details     String?
  reportedBy  String
  reportedAt  DateTime @default(now())
  resolved    Boolean  @default(false)
  resolvedBy  String?
  resolvedAt  DateTime?

  scenery     AirportScenery @relation(fields: [sceneryId], references: [id], onDelete: Cascade)

  @@index([sceneryId])
  @@index([resolved])
}

model DocumentationPermission {
  id        Int      @id @default(autoincrement())
  cid       Int
  pattern   String
  createdAt DateTime @default(now())

  @@index([cid])
}

model AirportDocument {
  id         Int      @id @default(autoincrement())
  icao       String
  filename   String
  uploadedBy Int
  uploadedAt DateTime @default(now())
  eventId    Int?

  @@unique([icao, filename])
  @@index([icao])
  @@index([eventId])
}

model DocumentationAccessRequest {
  id          Int       @id @default(autoincrement())
  cid         Int
  pattern     String
  name        String?
  email       String?
  role        String?
  requestedAt DateTime  @default(now())
  status      String    @default("PENDING")
  reviewedBy  Int?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([cid])
  @@index([status])
}

model StaffAccessRequest {
  id          Int       @id @default(autoincrement())
  cid         Int
  division    String
  name        String?
  email       String?
  role        String?
  rating      String?
  status      String    @default("PENDING")
  reviewedBy  Int?
  reviewedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([cid])
  @@index([status])
}

model FirEventAccess {
  id        Int      @id @default(autoincrement())
  cid       Int
  scope     String   // 'FIR' | 'DIVISION'
  value     String   // FIR code (e.g. "KZNY") or division name (e.g. "VATUSA")
  createdAt DateTime @default(now())
  createdBy Int?

  @@unique([cid, scope, value])
  @@index([cid])
}

// Per-WF-sector planning workspace. The dep and arr managers each propose
// an ATC route and we surface a validation panel comparing the two. Flow
// type lives here as a proposal — an admin can push it to the live
// WfScheduleRow separately.
model SectorPlan {
  id                 Int       @id @default(autoincrement())
  wf                 String
  fromIcao           String
  toIcao             String
  eventId            Int?
  depRouteSuggestion String?
  arrRouteSuggestion String?
  depSplitRoute      String?   // second route for traffic split (departure proposal)
  depSplitPct        Int?      // percentage on primary route (0-100), remainder on split
  arrSplitRoute      String?   // second route for traffic split (arrival proposal)
  arrSplitPct        Int?      // percentage on primary route (0-100), remainder on split
  splitAgreed        Boolean   @default(false)
  depFlowType        String?   // 'NONE' | 'BOOKING_REQUIRED'
  depFlowReason      String?   // reason for flow restriction (e.g. 'STAFFING', 'SINGLE_RUNWAY')
  depFlowRate        Int?      // planes/hr — only meaningful when depFlowType = BOOKING_REQUIRED
  arrFlowRequest     String?
  arrFlowReason      String?   // reason for flow request (e.g. 'STAFFING', 'SINGLE_RUNWAY')
  arrFlowRequestedBy Int?
  arrFlowRequestedAt DateTime?
  depUpdatedBy       Int?
  depUpdatedAt       DateTime?
  arrUpdatedBy       Int?
  arrUpdatedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([wf, eventId])
  @@index([wf])
}

// Route issues raised by enroute FIR managers once a route is agreed
// between Dep and Arr. Visible to everyone viewing the sector plan.
model SectorPlanIssue {
  id            Int       @id @default(autoincrement())
  sectorPlanId  Int
  wf            String
  raisedByCid   Int
  raisedByFir   String?
  notes         String
  status        String    @default("OPEN")   // 'OPEN' | 'RESOLVED'
  resolvedByCid Int?
  resolvedAt    DateTime?
  replies       String    @default("[]")     // JSON-encoded array of { cid, name?, fir?, side, notes, createdAt }
  createdAt     DateTime  @default(now())

  @@index([sectorPlanId])
  @@index([wf])
  @@index([status])
}

model MasterToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  cid       Int?
  label     String?
  createdAt DateTime @default(now())
  usedAt    DateTime?

  @@index([token])
  @@index([cid])
}

model UserAdditionalRole {
  id               Int      @id @default(autoincrement())
  cid              Int
  role             String
  teamName         String?
  sinceYear        Int?
  canEditBookings  Boolean  @default(true)
  canManageMembers Boolean  @default(false)
  participating    Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@unique([cid, role])
  @@index([cid])
}

model WfVisitedAirport {
  id        Int      @id @default(autoincrement())
  icao      String
  year      Int
  eventName String?

  @@unique([icao, year])
  @@index([icao])
}

model AirportSuggestion {
  id          Int      @id @default(autoincrement())
  firstName   String
  lastName    String
  icao        String
  type        String   @default("visit")
  association String
  reason      String
  contact     String
  notify      Boolean  @default(false)
  cid         Int?
  createdAt   DateTime @default(now())

  @@index([icao])
  @@index([type])
}

model TobtBookingBackup {
  id           Int      @id @default(autoincrement())
  eventId      Int
  slotKey      String
  cid          Int
  callsign     String
  from         String
  to           String
  dateUtc      String
  depTimeUtc   String
  tobtTimeUtc  String?
  originalId   Int
  backedUpAt   DateTime @default(now())

  @@index([eventId])
}

model WfScheduleRow {
  id          Int    @id @default(autoincrement())
  eventId     Int
  sortOrder   Int    @default(0)
  number      String
  from        String
  to          String
  dateUtc     String @default("")
  depTimeUtc  String @default("")
  arrTimeUtc  String @default("")
  blockTime   String @default("")
  flightTime  String @default("")
  atcRoute    String @default("")
  atcRoute2   String @default("")   // secondary route for traffic split
  isWfChallenge Boolean @default(false)
  vatcanEventId String?              // id returned by VATCAN's POST /api/event (e.g. "SCf56")

  @@unique([eventId, number])
  @@index([eventId])
}

model WfEvent {
  id             Int      @id @default(autoincrement())
  name           String
  year           Int
  sheetUrl       String   @default("")
  mode           String   @default("csv")
  isActive       Boolean  @default(false)
  turnaroundMins Int      @default(45)
  isWorldFlight  Boolean  @default(true)
  flightSuffix   String   @default("")
  flightStartNumber Int   @default(1)
  aircraftType   String   @default("B738")
  costIndex      Int      @default(30)
  startDateUtc   String   @default("")
  startTimeUtc   String   @default("")
  nextSectorAfter String  @default("BLOCK")
  cruiseAltitude Int      @default(0)
  cruiseMode     String   @default("CI")
  createdAt      DateTime @default(now())

  @@unique([year])
}

model WfChallengeScore {
  id        Int      @id @default(autoincrement())
  eventId   Int
  callsign  String
  style     Int
  speed     Int
  height    Int
  createdAt DateTime @default(now())

  @@index([eventId])
}

model PageVisibility {
  key     String  @id
  enabled Boolean @default(true)
  mode    String  @default("visible")
}

model MailingListSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  firstName String?
  lastName  String?
  cid       Int?
  createdAt DateTime @default(now())

  @@index([email])
}

model SiteSetting {
  key   String @id
  value String
}

model AdminPermission {
  id        Int      @id @default(autoincrement())
  cid       Int
  page      String   @db.VarChar(50)
  createdAt DateTime @default(now())

  @@unique([cid, page])
  @@index([cid])
}

model NavdataFile {
  name       String   @id
  cycle      String?
  content    Bytes
  uploadedAt DateTime @default(now())
}

model AffiliateApplication {
  id          Int       @id @default(autoincrement())
  callsign    String
  simType     String
  cid         Int
  sinceYear   Int?
  hasMembers  Boolean   @default(false)
  contact     String?
  notes       String?
  heardAbout  String?
  website     String?
  source      String    @default("admin")
  status      String    @default("pending")
  decidedBy   Int?
  decidedAt   DateTime?
  affiliateId Int?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([cid])
}

model AffiliateApplicationPhoto {
  id            Int      @id @default(autoincrement())
  applicationId Int
  filename      String
  mime          String
  data          Bytes
  createdAt     DateTime @default(now())

  @@index([applicationId])
}

model ProfilePhoto {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  mime       String
  data       Bytes
  updatedAt  DateTime @default(now())

  @@unique([entityType, entityId])
}

model TeamSectorOptOut {
  id             Int      @id @default(autoincrement())
  officialTeamId Int
  sectorNumber   String
  createdAt      DateTime @default(now())

  @@unique([officialTeamId, sectorNumber])
  @@index([officialTeamId])
}

model TeamSectorAssignment {
  id             Int      @id @default(autoincrement())
  officialTeamId Int
  sectorNumber   String
  cid            Int
  updatedAt      DateTime @default(now())

  @@unique([officialTeamId, sectorNumber])
  @@index([officialTeamId])
}
